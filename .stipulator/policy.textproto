invocations {
  name: "core-race"
  timeout {
    seconds: 3600
  }
  go {
    packages: "./..."
    race: true
    args: "-test.timeout=30m"
  }
}

invocations {
  name: "mount-race"
  timeout {
    seconds: 3600
  }
  go {
    module_root: "mount"
    packages: "./..."
    race: true
    args: "-test.timeout=30m"
  }
}
